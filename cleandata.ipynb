        "AGGRAVATED SEXUAL ASSAULT OF CHILD BY FAMILY MEMBER",
    "CRIMINAL SEX ABUSE BY FAM MEMBER":
        "CRIMINAL SEXUAL ABUSE BY FAMILY MEMBER",
    "ENDANGERING LIFE/HEALTH CHILD": "ENDANGERING LIFE/HEALTH OF CHILD",
    "POS: PORNOGRAPHIC PRINT": "POSSESSION OF PORNOGRAPHIC PRINT",
    "SALE TOBACCO PRODUCTS TO MINOR": "SALE OF TOBACCO PRODUCTS TO MINOR",
    "SEX ASSLT OF CHILD BY FAM MBR":
        "SEXUAL ASSAULT OF CHILD BY FAMILY MEMBER",
    # OTHER OFFENSE
    "SEX OFFENDER: FAIL REG NEW ADD":
        "SEX OFFENDER: FAIL TO REGISTER NEW ADDRESS",
    "VEHICLE TITLE/REG OFFENSE": "VEHICLE TITLE/REGISTRATION OFFENSE",
    "VIO BAIL BOND: DOM VIOLENCE":
        "VIOLATION OF BAIL BOND - DOMESTIC VIOLENCE",
    # PROSTITUTION
    "SOLICIT FOR BUSINESS": "SOLICITING FOR BUSINESS",
    "SOLICIT FOR PROSTITUTE": "SOLICITING FOR A PROSTITUTE",
    # SEX OFFENSE
    "INDECENT SOLICITATION/ADULT": "INDECENT SOLICITATION OF AN ADULT",
    "INDECENT SOLICITATION/CHILD": "INDECENT SOLICITATION OF A CHILD",
    "NON-CONSENSUAL DISSEMINATION PRIVATE SEXUAL IMAGES":
        "NON-CONSENSUAL DISSEMINATION OF PRIVATE SEXUAL IMAGES",
    # THEFT
    "FROM COIN-OP MACHINE/DEVICE": "FROM COIN-OPERATED MACHINE OR DEVICE",
    # WEAPONS VIOLATION
    "DEFACE IDENT MARKS OF FIREARM": "DEFACE IDENTIFICATION MARKS OF FIREARM",
    "POSSESSION FIREARM/AMMO: NO FOID CARD":
        "POSSESS FIREARM/AMMUNITION - NO FOID CARD",
    "UNLAWFUL POSSESSION OF HANDGUN": "UNLAWFUL POSSESSION - HANDGUN",
    "UNLAWFUL USE/SALE AIR RIFLE": "UNLAWFUL USE/SALE OF AIR RIFLE",
    # OFFENSE INVOLVING CHILDREN (xác nhận cùng IUCR 1725 trong DIM_CRIME_TYPE)
    "CONTRIBUTE CRIMINAL DELINQUENCY JUVENILE":
        "CONTRIBUTE TO THE CRIMINAL DELINQUENCY OF CHILD",
}

# Cùng một chuỗi nhưng đích khác nhau tùy Primary Type
# (ASSAULT không có "thương tích" như BATTERY)
TYPE_SPECIFIC_MAP = {
    ("ASSAULT", "AGGRAVATED POLICE OFFICER HANDS NO/MIN INJURY"):
        "AGGRAVATED POLICE OFFICER: HANDS, FISTS, FEET, NO INJURY",
    ("BATTERY", "AGGRAVATED POLICE OFFICER HANDS NO/MIN INJURY"):
        "AGGRAVATED POLICE OFFICER: HANDS, FISTS, FEET, NO/MINOR INJURY",
}


def normalize_description(s: pd.Series) -> pd.Series:
    s = s.astype("string").str.strip().str.upper()
    s = s.str.replace(r"\s+", " ", regex=True)

    for pattern, repl in DESCRIPTION_RULES:
        s = s.str.replace(pattern, repl, regex=True)

    s = s.str.strip()
    s = s.replace(DESCRIPTION_EXCEPTIONS)
    s = s.replace(DESCRIPTION_CANONICAL_MAP)

    return s


def apply_type_specific_map(ptype: pd.Series, desc: pd.Series) -> pd.Series:
    for (pt, old), new in TYPE_SPECIFIC_MAP.items():
        mask = ((ptype == pt) & (desc == old)).fillna(False).astype(bool)
        desc = desc.mask(mask, new)
    return desc
# RULES>>


# =========================================================
# ĐỌC DỮ LIỆU
# =========================================================
print("Đang đọc dữ liệu gốc...")

df = pd.read_csv(file_input, low_memory=False)
n_raw = len(df)

required_cols = [
    "ID",
    "Date",
    "Primary Type",
    "Description",
    "Location Description",
    "Case Number",
]

missing_cols = [col for col in required_cols if col not in df.columns]

if missing_cols:
    raise ValueError(f"Thiếu các cột bắt buộc: {missing_cols}")

n_missing_id_raw = int(df["ID"].isna().sum())

# =========================================================
# 1. CHUẨN HÓA NGÀY THÁNG
# =========================================================
date_parse_failed = {}
date_missing_raw = {}

for col in ["Date", "Updated On"]:
    if col not in df.columns:
        continue

    original = df[col].astype("string").str.strip()

    date_missing_raw[col] = int(original.isna().sum() + original.eq("").sum())

    parsed = pd.to_datetime(original, format=DATE_FORMAT, errors="coerce")

    # Chỉ thử parse tự động với những giá trị chưa đọc được
    failed_mask = original.notna() & parsed.isna()
    failed_mask &= original.ne("")

    if failed_mask.any():
        parsed.loc[failed_mask] = pd.to_datetime(
            original.loc[failed_mask], errors="coerce"
        )

    date_parse_failed[col] = int(
        (original.notna() & original.ne("") & parsed.isna()).sum()
    )

    df[col] = parsed

# =========================================================
# 2. LỌC DỮ LIỆU TỪ NĂM 2020 ĐẾN HIỆN TẠI
# =========================================================
n_date_missing = int(df["Date"].isna().sum())

now = pd.Timestamp.now()

valid_date = (
    df["Date"].notna()
    & (df["Date"] >= pd.Timestamp("2020-01-01"))
    & (df["Date"] <= now)
)

df = df.loc[valid_date].copy()

n_after_date_filter = len(df)

# =========================================================
# 3. CHUẨN HÓA PRIMARY TYPE
# =========================================================
df["Primary Type"] = df["Primary Type"].astype("string").str.strip().str.upper()

primary_type_mapping = {
    "NON - CRIMINAL": "NON-CRIMINAL",
    "NON - CRIMINAL (SUBJECT SPECIFIED)": "NON-CRIMINAL (SUBJECT SPECIFIED)",
    "CRIM SEXUAL ASSAULT": "CRIMINAL SEXUAL ASSAULT",
    "CRIM SEX ABUSE": "CRIMINAL SEX ABUSE",
}

df["Primary Type"] = df["Primary Type"].replace(primary_type_mapping)

# =========================================================
# 4. CHUẨN HÓA DESCRIPTION
# =========================================================
n_description_before = df["Description"].nunique()

df["Description"] = normalize_description(df["Description"])
df["Description"] = apply_type_specific_map(
    df["Primary Type"], df["Description"]
)

# =========================================================
# 5. CHUẨN HÓA LOCATION DESCRIPTION
# =========================================================
df["Location Description"] = (
    df["Location Description"]
    .astype("string")
    .str.strip()
    .str.upper()
    .str.replace(r"\s+", " ", regex=True)
)

location_desc_mapping = {
    "PARKING LOT/GARAGE(NON. RESID.)": "PARKING LOT / GARAGE (NON-RESIDENTIAL)",
    "PARKING LOT/GARAGE(NON.RESID.)": "PARKING LOT / GARAGE (NON-RESIDENTIAL)",
    "PARKING LOT / GARAGE (NON. RESID.)": "PARKING LOT / GARAGE (NON-RESIDENTIAL)",
    "RESIDENCE-GARAGE": "RESIDENCE - GARAGE",
}

df["Location Description"] = df["Location Description"].replace(
    location_desc_mapping
)

# "RESIDENCE-PORCH/HALLWAY" -> "RESIDENCE - PORCH/HALLWAY", ...
df["Location Description"] = df["Location Description"].str.replace(
    r"^RESIDENCE\s*-\s*", "RESIDENCE - ", regex=True
)

# =========================================================
# 6. XỬ LÝ GIÁ TRỊ HÀNH CHÍNH
# =========================================================
for col in ["Community Area", "Ward", "District"]:
    if col in df.columns:
        df[col] = pd.to_numeric(df[col], errors="coerce")
        df[col] = df[col].replace(0, np.nan)



# =========================================================
# 7. KIỂM TRA CASE NUMBER VÀ ID
# =========================================================
n_case_number_missing = int(df["Case Number"].isna().sum())
n_missing_id = int(df["ID"].isna().sum())
n_duplicates = int(df.loc[df["ID"].notna(), "ID"].duplicated().sum())

# Chỉ xóa ID trùng; giữ lại ID thiếu để kiểm tra
df = df.drop_duplicates(subset=["ID"], keep="first")

# =========================================================
# 8. KIỂM TRA SAU TIỀN XỬ LÝ
# =========================================================
n_final = len(df)
n_description_unique = df["Description"].nunique()

# =========================================================
# 9. LƯU DỮ LIỆU
# =========================================================
df.to_csv(file_output, index=False, encoding="utf-8-sig")

# =========================================================
# 10. BÁO CÁO KẾT QUẢ
# =========================================================
print("\n========== BÁO CÁO TIỀN XỬ LÝ ==========")

print(f"1. Tổng số dòng dữ liệu gốc: {n_raw:,}")
print(f"2. Dòng thiếu ID ban đầu: {n_missing_id_raw:,}")
print(f"3. Dòng Date thiếu sau parse: {n_date_missing:,}")
print(f"4. Dòng sau khi lọc ngày: {n_after_date_filter:,}")
print(f"5. Số dòng ID thiếu: {n_missing_id:,}")
print(f"6. Số ID trùng đã loại bỏ: {n_duplicates:,}")
print(f"7. Case Number thiếu: {n_case_number_missing:,}")
print(f"8. Tọa độ không hợp lệ: {n_bad_coord:,}")
print(f"9. Số dòng cuối cùng: {n_final:,}")
print(f"10. Số cột dữ liệu: {len(df.columns)}")
print(
    f"11. Số Description khác nhau: {n_description_before:,} -> "
    f"{n_description_unique:,}"
)

print("\nSố giá trị ngày không parse được:")
for col, count in date_parse_failed.items():
    print(f"- {col}: {count:,}")

print("\nDanh sách Primary Type:")
print(sorted(df["Primary Type"].dropna().unique().tolist()))

print(f"\nĐã lưu dữ liệu tại: {file_output}")


# =========================================================
# 11. CHẨN ĐOÁN DESCRIPTION CÒN CẦN KIỂM TRA
# =========================================================
if RUN_DIAGNOSTICS:

    desc_audit = (
        df.groupby(
            ["Primary Type", "Description"],
            dropna=False
        )
        .size()
        .reset_index(name="Count")
    )

    desc_audit["Needs_Review"] = (
        desc_audit["Description"]
        .astype("string")
        .str.contains(
            r"\b(?:AGG|CRIM|ATT|DANG|WEAP|INSTR|POSS|"
            r"MANU|PRO|EMP)\b"
            r"|MANU/DEL(?:IVER)?"
            r"|NON\s+-\s*CRIMINAL|NON\s*-\s+CRIMINAL"
            r"|\$\s+\d"
            r"|-{2,}"
            r"|\s{2,}",
            regex=True,
            na=False
        )
    )

    # Tạo khóa bỏ dấu câu để phát hiện biến thể
    desc_audit["Key"] = (
        desc_audit["Description"]
        .fillna("")
        .str.replace(r"[^A-Z0-9$]", "", regex=True)
    )

    desc_audit["Dup_Key"] = desc_audit.duplicated(
        ["Primary Type", "Key"],
        keep=False
    )

    # Gộp hai điều kiện kiểm tra
    desc_audit["Needs_Review"] = (
        desc_audit["Needs_Review"]
        | desc_audit["Dup_Key"]
    )

    review = (
        desc_audit[desc_audit["Needs_Review"]]
        .sort_values(
            ["Primary Type", "Count"],
            ascending=[True, False]
        )
    )

    print("\n=== DESCRIPTION CẦN KIỂM TRA ===")

    if review.empty:
        print("Không phát hiện biến thể theo các quy tắc đã đặt.")
    else:
        print(review.to_string(index=False))

    desc_audit.to_csv(
        "Chicago_Description_Audit.csv",
        index=False,
        encoding="utf-8-sig"
    )

    print("\nĐã xuất báo cáo: Chicago_Description_Audit.csv")


# =========================================================
# 12. KIỂM TRA IUCR: CÙNG MÃ NHƯNG NHIỀU DESCRIPTION
# =========================================================
if RUN_DIAGNOSTICS and "IUCR" in df.columns:
    iucr_check = df.groupby(["Primary Type", "IUCR"])["Description"].agg(
        lambda s: s.value_counts().to_dict()
    )
    multi = iucr_check[iucr_check.map(len) > 1]

    print("\n=== CÙNG PRIMARY TYPE + IUCR NHƯNG NHIỀU DESCRIPTION ===")
    if multi.empty:
        print("Không có.")
    else:
        print(multi.to_string())


# =========================================================
# 13. KIỂM TRA FBI CODE: CÙNG IUCR + DESCRIPTION NHƯNG KHÁC FBI CODE
# =========================================================
if RUN_DIAGNOSTICS and {"IUCR", "FBI Code"}.issubset(df.columns):
    fbi_check = (
        df.groupby(["IUCR", "Primary Type", "Description", "FBI Code"])
        .agg(Count=("ID", "size"), First=("Date", "min"), Last=("Date", "max"))
        .reset_index()
    )

    fbi_conflict = fbi_check[
        fbi_check.duplicated(["IUCR", "Primary Type", "Description"], keep=False)
    ].sort_values(["IUCR", "Count"], ascending=[True, False])

    print("\n=== CÙNG IUCR + DESCRIPTION NHƯNG NHIỀU FBI CODE ===")
    if fbi_conflict.empty:
        print("Không có.")
    else:
        print(fbi_conflict.to_string(index=False))

