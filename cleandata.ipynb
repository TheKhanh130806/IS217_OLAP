import numpy as np
import pandas as pd

# =========================================================
# CẤU HÌNH
# =========================================================
pd.set_option("display.max_columns", None)
pd.options.display.float_format = "{:,.1f}".format

file_input = "Crimes_-_2001_to_Present.csv"
file_output = "Chicago_Crimes_2020_Present_Cleaned.csv"

DATE_FORMAT = "%m/%d/%Y %I:%M:%S %p"

# Đặt True để in bảng chẩn đoán các biến thể Description còn sót
RUN_DIAGNOSTICS = True

# <<RULES
# ---------------------------------------------------------
# QUY TẮC CHUẨN HÓA DESCRIPTION (áp dụng lần lượt, thứ tự quan trọng)
# ---------------------------------------------------------
DESCRIPTION_RULES = [
    # --- Chuẩn hóa dấu gạch chéo TRƯỚC các quy tắc dùng "/" (THEFT/RECOVERY...)
    (r"\s*/\s*", "/"),

    # --- Dấu gạch trong NON-CRIMINAL
    (r"\bNON\s*-\s*CRIMINAL\b", "NON-CRIMINAL"),

    # --- Mở rộng từ viết tắt
    (r"\bPRO\.?\s*EMP\b\.?", "PROTECTED EMPLOYEE"),
    (r"(?<![A-Z0-9])P\.?O\.?(?![A-Z0-9])", "POLICE OFFICER"),
    (r"\bAGG\b\.?", "AGGRAVATED"),
    (r"\bCRIM\b\.?", "CRIMINAL"),
    (r"\bATT\b\.?", "ATTEMPT"),
    (r"\bDANG\b\.?", "DANGEROUS"),
    (r"\bWEAP\b\.?", "WEAPON"),
    (r"\bCUT\b(?=\s+INSTR)", "CUTTING"),
    (r"\bINSTR\b\.?", "INSTRUMENT"),
    (r"\bINST\b\.?", "INSTRUMENT"),            # MỚI: KNIFE/CUTTING INST
    (r"INSTSTRUMENT", "INSTRUMENT"),           # MỚI: lỗi gõ trong dữ liệu gốc
    (r"\bPOSS\b\.?", "POSSESSION"),
    (r"\bMANU/DEL(?:IVER)?\b", "MANUFACTURE/DELIVERY"),
    (r"\bSTRONG[\s-]?ARM\b", "STRONG ARM"),

    # --- Số tiền: "$ 300" -> "$300"
    (r"\$\s+(?=\d)", "$"),

    # --- Dấu phân cách sau các tiền tố
    (r"\bATTEMPT\s*[-:]\s*", "ATTEMPT "),
    (
        r"\b(ARMED|AGGRAVATED DOMESTIC BATTERY|AGGRAVATED|STRONG ARM|"
        r"UNLAWFUL USE|POLICE OFFICER|PROTECTED EMPLOYEE|"
        r"THEFT/RECOVERY|ARSONIST|GUN OFFENDER|SEX OFFENDER|"
        r"VIOLENT OFFENDER)\s*[-:]\s*",         # MỚI: thêm 7 tiền tố
        r"\1: ",
    ),

    # --- Khoảng trắng / dấu câu
    (r"(?<=[A-Z0-9])\(", " ("),
    (r"\(\s+", "("),
    (r"\s+\)", ")"),
    (r":(?=[A-Z(])", ": "),
    (r",(?=[A-Z])", ", "),                      # MỚI: "LESSEE,MOTOR" -> "LESSEE, MOTOR"
    (r"\s+", " "),

    # --- NARCOTICS: thống nhất hai kiểu đặt tên theo kiểu phổ biến hơn
    (r"^POSSESSION:\s*", "POSSESS - "),
    (r"^MANUFACTURE/DELIVERY:\s*", "MANUFACTURE/DELIVER - "),
    (r"\bBARBITUATES\b", "BARBITURATES"),
    (r"\bMETHAMPHETAMINES\b", "METHAMPHETAMINE"),
    (r"\b30\s*GMS\b", "30 GRAMS"),
    (r"\b10\s*GMS\b", "10 GRAMS"),
    (r"\b10\s*GM\b", "10 GRAMS"),
    (r"HEROIN\s*\(BRN/TAN\)", "HEROIN (TAN/BROWN TAR)"),
    (r"^POS: HYPODERMIC NEEDLE$", "POSSESS - HYPODERMIC NEEDLE"),
]

# Chỉ giữ các trường hợp ngoại lệ mà regex không bắt được
DESCRIPTION_EXCEPTIONS = {
    "FINANCIAL IDENTITY THEFT OVER $ 300": "FINANCIAL IDENTITY THEFT OVER $300",
    "ATTEMPT AGGRAVATED - HANDGUN": "ATTEMPT AGGRAVATED: HANDGUN",
    "AGGRAVATED - HANDGUN": "AGGRAVATED: HANDGUN",
    "NON - CRIMINAL": "NON-CRIMINAL",
}

